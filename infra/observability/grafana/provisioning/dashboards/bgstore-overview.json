{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(up{job=~\"$api_job\"})",
          "refId": "A"
        }
      ],
      "title": "API instances up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2,
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "title": "Request rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",status=~\"5..\",uri!=\"/actuator/prometheus\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval])), 1)",
          "refId": "A"
        }
      ],
      "title": "5xx error rate",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_sum{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval])), 1)",
          "refId": "A"
        }
      ],
      "title": "Average request latency",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (method, status) (rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP traffic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_milliseconds_sum{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval])), 1)",
          "legendFormat": "average",
          "refId": "A"
        }
      ],
      "title": "HTTP average latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * sum by (status) (rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",status=~\"4..|5..\",uri!=\"/actuator/prometheus\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{job=\"otel-collector\",exported_job=~\"$api_job\",uri!=\"/actuator/prometheus\"}[$__rate_interval])), 1)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP error rate by status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * sum(jvm_memory_used_bytes{job=\"otel-collector\",exported_job=~\"$api_job\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"otel-collector\",exported_job=~\"$api_job\",area=\"heap\"}), 1)",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "100 * sum(process_cpu_usage{job=\"otel-collector\",exported_job=~\"$api_job\"})",
          "legendFormat": "process CPU",
          "refId": "B"
        }
      ],
      "title": "JVM heap and process CPU",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_active{job=\"otel-collector\",exported_job=~\"$api_job\"})",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(hikaricp_connections_idle{job=\"otel-collector\",exported_job=~\"$api_job\"})",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "sum(hikaricp_connections_pending{job=\"otel-collector\",exported_job=~\"$api_job\"})",
          "legendFormat": "pending",
          "refId": "C"
        }
      ],
      "title": "Database connection pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(otelcol_receiver_accepted_spans{job=\"otel-collector\"}[$__rate_interval]))",
          "legendFormat": "spans received",
          "refId": "A"
        },
        {
          "expr": "sum(rate(otelcol_exporter_sent_spans{job=\"otel-collector\"}[$__rate_interval]))",
          "legendFormat": "spans exported",
          "refId": "B"
        },
        {
          "expr": "sum(rate(otelcol_receiver_refused_spans{job=\"otel-collector\"}[$__rate_interval]))",
          "legendFormat": "spans refused",
          "refId": "C"
        }
      ],
      "title": "OTel trace pipeline",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "id": 11,
      "options": {
        "deduplication": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLines": false
      },
      "targets": [
        {
          "expr": "{service_name=\"bgstore-api\"}",
          "refId": "A"
        }
      ],
      "title": "API logs (when emitted)",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "id": 12,
      "options": {
        "show exemplars": true,
        "showLegend": true
      },
      "targets": [
        {
          "query": "{ resource.service.name = \"bgstore-api\" }",
          "queryType": "traceql",
          "refId": "A"
        }
      ],
      "title": "API traces",
      "type": "traces"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["bgstore", "opentelemetry", "spring-boot"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "bgstore-api",
          "value": "bgstore-api"
        },
        "includeAll": true,
        "label": "API job",
        "name": "api_job",
        "options": [],
        "query": "label_values(http_server_requests_milliseconds_count, exported_job)",
        "refresh": 1,
        "regex": "/.*(bgstore|api).*/",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        }
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "BGStore / Observability Overview",
  "uid": "bgstore-overview",
  "version": 1,
  "weekStart": ""
}
