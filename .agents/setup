#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="$HOME/.local/bin"
mise_bin="$local_bin/mise"
mise_version="2026.9.12"
helm_version="3.19.0"
compose_version="5.5.1"

log_step() {
  local label="$1"
  shift
  local started=$SECONDS
  printf '\n==> %s\n' "$label"
  "$@"
  printf '    completed in %ss\n' "$((SECONDS - started))"
}

install_mise() {
  if [[ -x "$mise_bin" ]] && "$mise_bin" --version | grep -Fq "$mise_version"; then
    return
  fi

  local archive="$work_dir/mise.tar.gz"
  curl -fsSL \
    "https://github.com/jdx/mise/releases/download/v${mise_version}/mise-v${mise_version}-linux-x64.tar.gz" \
    -o "$archive"
  printf '%s  %s\n' \
    'b4058dece685259910d3aba5782445996eea79dbdb3cf952a6eb81aadf0373ff' \
    "$archive" | sha256sum --check --status
  tar -xzf "$archive" -C "$work_dir"
  install -m 0755 "$work_dir/mise/bin/mise" "$mise_bin"
}

install_helm() {
  if [[ -x "$local_bin/helm" ]] && "$local_bin/helm" version --short | grep -Fq "v${helm_version}"; then
    return
  fi

  local archive="$work_dir/helm.tar.gz"
  curl -fsSL "https://get.helm.sh/helm-v${helm_version}-linux-amd64.tar.gz" -o "$archive"
  printf '%s  %s\n' \
    'a7f81ce08007091b86d8bd696eb4d86b8d0f2e1b9f6c714be62f82f96a594496' \
    "$archive" | sha256sum --check --status
  tar -xzf "$archive" -C "$work_dir"
  install -m 0755 "$work_dir/linux-amd64/helm" "$local_bin/helm"
}

install_docker() {
  if command -v docker >/dev/null 2>&1 &&
    command -v dockerd >/dev/null 2>&1 &&
    docker buildx version >/dev/null 2>&1; then
    return
  fi

  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/debian/gpg \
    -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian %s stable\n' \
    "$(dpkg --print-architecture)" \
    "$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")" |
    sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin
}

install_compose() {
  local compose_bin="$HOME/.docker/cli-plugins/docker-compose"
  if [[ -x "$compose_bin" ]] &&
    [[ "$("$compose_bin" version --short)" == "$compose_version" ]]; then
    return
  fi

  mkdir -p "$(dirname "$compose_bin")"
  curl -fsSL \
    "https://github.com/docker/compose/releases/download/v${compose_version}/docker-compose-linux-x86_64" \
    -o "$work_dir/docker-compose"
  printf '%s  %s\n' \
    'db1889184726840f75c4f9c001048430d4f25b3be3cb084d3ddd762bc0aed576' \
    "$work_dir/docker-compose" | sha256sum --check --status
  install -m 0755 "$work_dir/docker-compose" "$compose_bin"
}

configure_login_shell() {
  local profile_dir="$HOME/.config/bgstore"
  local profile_script="$profile_dir/orb-profile.sh"
  local profile_marker='# BGStore orb toolchain'

  mkdir -p "$profile_dir"
  cat > "$profile_script" <<EOF
# Generated by $repo_root/.agents/setup.
case "\$PWD" in
  "$repo_root"|"$repo_root"/*)
    if [[ -z "\${BGSTORE_MISE_ENV_ACTIVE:-}" ]]; then
      export BGSTORE_MISE_ENV_ACTIVE=1
      eval "\$("$mise_bin" env --shell bash)"
    fi
    ;;
esac
EOF

  if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
source "$profile_script"
EOF
  fi
}

link_toolchain() {
  # Login shells get the toolchain from the profile above, but agents and other
  # automation run commands in non-interactive shells that never read it. Point
  # the pinned tools at their mise shims from ~/.local/bin, which is already on
  # PATH everywhere, so `pnpm check` finds Java without a manual export.
  local tool
  for tool in node npm npx pnpm corepack java javac jar; do
    local shim="$HOME/.local/share/mise/shims/$tool"
    [[ -x "$shim" ]] || continue
    ln -sfn "$shim" "$local_bin/$tool"
  done
}

install_git_hooks() {
  # The dependency install above skips lifecycle scripts, so the prepare script
  # never runs. Install Lefthook explicitly: without it a commit skips the
  # Prettier, ESLint and Spotless checks that CI enforces.
  # Preserve user-managed hooks (for example an orb's commit-message hook)
  # rather than replacing their global hooks path with repository hooks.
  if [[ -n "$(git config --get core.hooksPath || true)" ]]; then
    printf '    preserving configured core.hooksPath; skipping Lefthook installation\n'
    return
  fi
  "$mise_bin" exec -- pnpm exec lefthook install
}

mkdir -p "$local_bin"
work_dir="$(mktemp -d)"
trap 'rm -rf "$work_dir"' EXIT

log_step 'Install mise' install_mise
log_step 'Install Helm' install_helm
log_step 'Install Docker Engine and Buildx' install_docker
log_step 'Install Docker Compose' install_compose

cd "$repo_root"
[[ -f .env ]] || cp -- .env.example .env
[[ -f .env.local ]] || cp -- .env.example .env.local

log_step 'Install pinned Node, pnpm, and Java toolchains' "$mise_bin" install --yes
log_step 'Refresh mise shims' "$mise_bin" reshim
log_step 'Expose the toolchain to non-interactive shells' link_toolchain
log_step 'Install locked workspace dependencies' \
  "$mise_bin" exec -- pnpm install --frozen-lockfile --ignore-scripts
log_step 'Install the Playwright Chromium build' \
  "$mise_bin" exec -- pnpm exec playwright install chromium
log_step 'Install the Lefthook git hooks' install_git_hooks
log_step 'Configure login shells' configure_login_shell

printf '\nBGStore orb setup complete.\n'
