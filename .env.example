# Copy to .env. Set local-only passwords before make up; never commit .env.
IMAGE_TAG=dev
POSTGRES_DB=theparlor
POSTGRES_USER=theparlor
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_SSL_ENABLED=false
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
KEYCLOAK_PORT=8081
# Local inbox for development password-reset messages.
MAILPIT_PORT=8025
WEB_PORT=5173
API_PORT=8080
# Server-side confidential OIDC client; never expose this secret through VITE_*.
THEPARLOR_OIDC_CLIENT_SECRET=
THEPARLOR_PUBLIC_ORIGIN=http://localhost:5173
# Payment provider: none, bogus (the local default; moves no money) or omise. Omise needs both
# keys; use test keys locally and never commit real ones. Uncomment to switch provider.
# THEPARLOR_PAYMENT_GATEWAY=omise
THEPARLOR_OMISE_PUBLIC_KEY=
THEPARLOR_OMISE_SECRET_KEY=
SESSION_COOKIE_SECURE=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTLP_PORT=4318
# Docker daemon-side socket. make configure detects rootless Lima when Docker is running.
DOCKER_SOCKET=/var/run/docker.sock
TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
# Local user created only by make seed-dev-user (not imported into staging/prod).
E2E_USERNAME=developer
E2E_PASSWORD=
