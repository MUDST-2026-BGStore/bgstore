{
  "name": "@theparlor/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "todos": "node tools/list-todos.mjs",
    "generate:api": "pnpm check:contract && cd apps/api && ./gradlew openApiGenerate generateWebClient",
    "generate:web-api": "pnpm bundle:contract && orval",
    "check:contract": "pnpm lint:contract && cd apps/api && ./gradlew openApiValidate",
    "test": "nx run-many -t test --exclude=api",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "build": "nx build web",
    "format:check": "prettier --check .",
    "lint:contract": "redocly lint theparlor --lint-config=error",
    "bundle:contract": "redocly bundle theparlor --output dist/openapi/theparlor.openapi.yaml --lint-config=error",
    "knip": "knip --include files,dependencies,unlisted,unresolved,binaries"
  },
  "private": true,
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.8.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "23.3.0",
    "@nx/plugin": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/vue": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@playwright/test": "^1.37.0",
    "@redocly/cli": "2.64.1",
    "@swc/helpers": "~0.5.18",
    "@theparlor/backend-tools": "workspace:*",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-vue": "^9.16.1",
    "fast-check": "^4.10.2",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "knip": "^5.88.1",
    "nx": "23.3.0",
    "orval": "8.43.0",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "~5.0.1",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.10.0 <27",
    "pnpm": ">=10.33.0 <11"
  }
}
